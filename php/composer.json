{
    "name": "matheuslm7/brazil-validator",
    "description": "Validation, normalization, and formatting for Brazilian data: CPF, CNPJ, CEP, phone numbers, e-mail, PIX keys, and Inscricao Estadual.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/matheuslm7/brazil-validator/tree/master/php",
    "authors": [
        {
            "name": "matheuslm7"
        }
    ],
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "BrValidator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BrValidator\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable"
}
